<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="LocationTracker.MainPage"
             Title="Location Tracker">

    <!-- 
        Main map view for the application.
        This page currently focuses on displaying the user's real-time location.
        
        Notes:
        - MapType is set to Street for standard road-level detail.
        - IsShowingUser enables the platform-native blue location indicator.
        - Additional overlays (pins, heat map layers) can be added later.
    -->
    <maps:Map x:Name="MyMap"
              IsShowingUser="True"
              MapType="Street" />

</ContentPage>