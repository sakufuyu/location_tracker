<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:LocationTracker"
       x:Class="LocationTracker.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="Location Tracker">

    <!--
        Root navigation structure.
        Flyout is disabled b/c this application uses
        a single-page map interface without hierarchial navigation.
    -->
    <!--
        MainPage is loaded via DataTemplate to enale lazy instantiation.
        This improves startup performance and aligns with shell routing.
    -->
    <ShellContent
        Title="Map"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
</Shell>